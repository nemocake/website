    {
      "slug": "martens-halftone",
      "name": "MARTENS HALFTONE",
      "edition": 10,
      "kind": "edition",
      "year": 2026,
      "after": "Karel Martens",
      "medium": "glyph halftone engine",
      "status": "approved",
      "note": "A study after one of the greatest designers of all time, Karel Martens. One specific aspect of his design has always caught my eye is his use of generative glyphs as ASCII or halftone-like filters. Two examples in particular have always stuck with me. The process of recreating this glyph system started with looking closely at the works and breaking the glyphs down into their individual components. Once I had a catalogue of individual glyph elements, it was a simple step to a system that randomly overlays a set number of components and applies a riso-like colour opacity to each. Then one step further in making it a real-time glyph generator, constantly evolving new glyphs as you sit with it.",
      "images": [
        {
          "file": "hero.jpg",
          "title": "",
          "caption": "a field of generated glyphs",
          "w": 2200,
          "h": 1243
        },
        {
          "file": "riso-horse.jpg",
          "title": "",
          "caption": "a photograph rebuilt through the glyph filter",
          "w": 4096,
          "h": 2339
        },
        {
          "file": "animated.mp4",
          "title": "the generator",
          "caption": "real-time glyphs, evolving",
          "video": true
        }
      ],
      "series": "misc",
      "tags": [
        "halftone",
        "glyphs",
        "overprint"
